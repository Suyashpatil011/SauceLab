<suite name="AutomationSuite">
    <listeners>
        <listener class-name="Listener.TestListener"/>
    </listeners>
    <test name="LoginAndCartTests">
        <groups>
            <run>
                <!-- Order is enforced via dependsOnGroups on each @Test, not by listing classes here. -->
                <include name="sanity"/>
            </run>
        </groups>
        <packages>
            <package name="Test"/>
        </packages>
    </test>
</suite>
